{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vtubeadmirer/chatcoach/blob/main/schemas/training-event.schema.json",
  "title": "훈련 기록 한 줄 (training/<session_id>.jsonl)",
  "description": "스트리머 훈련(F) 세션 기록 파일의 한 줄. 라벨 기록(label-event)과 다른 폴더·다른 종류다(08 D-05·D-18 8, 18 6-3). 파일은 추가만 하는 JSON Lines(UTF-8, BOM 없음, LF), 한 줄 = 기록 1건. 채팅 본문·닉네임·전사문은 넣지 않는다 — chat_id·VOD 시각(ms)·숫자만(D-17 8). 같은 규칙을 app/training_store.py 가 이 스키마로 검사한다(store.LabelSchema 해석기).",
  "type": "object",
  "required": ["v", "id", "seq", "kind", "session_id", "labeler_id", "created_at", "app_version", "body"],
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1, "description": "훈련 기록 형식 버전."},
    "id": {"$ref": "#/$defs/uuid"},
    "seq": {"type": "integer", "minimum": 1, "description": "파일 안 순번. 1부터 1씩 늘어난다."},
    "kind": {"enum": ["training.start", "training.pick", "training.unpick", "training.compare", "training.end"]},
    "session_id": {"$ref": "#/$defs/trainingSessionId"},
    "labeler_id": {"$ref": "#/$defs/labelerId"},
    "created_at": {"$ref": "#/$defs/datetime", "description": "기록한 벽시계 시각(OS 시간대 오프셋 포함)."},
    "app_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"},
    "body": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "training.start"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/startBody"}}}},
    {"if": {"properties": {"kind": {"const": "training.pick"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/pickBody"}}}},
    {"if": {"properties": {"kind": {"const": "training.unpick"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/unpickBody"}}}},
    {"if": {"properties": {"kind": {"const": "training.compare"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/compareBody"}}}},
    {"if": {"properties": {"kind": {"const": "training.end"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/endBody"}}}}
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "labelerId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$", "description": "라벨러 코드(표시 이름은 넣지 않는다)."},
    "trainingSessionId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}-TR-[0-9]{8}-[a-z0-9]{4}$", "description": "'<labeler_id>-TR-<yyyymmdd>-<4자>'. 라벨 세션 종류 코드(P·RS·R2·AD·OR·AN)와 겹치지 않는다."},
    "datetime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?([+-][0-9]{2}:[0-9]{2}|Z)$"},
    "chatId": {"type": "string", "pattern": "^c[0-9a-f]{20}(_[0-9]+)?$"},
    "ms": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "range": {
      "type": "object",
      "required": ["start_ms", "end_ms"],
      "additionalProperties": false,
      "properties": {"start_ms": {"$ref": "#/$defs/ms"}, "end_ms": {"$ref": "#/$defs/ms"}}
    },
    "reference": {
      "type": "object",
      "required": ["source", "sha256", "count"],
      "additionalProperties": false,
      "description": "훈련 기준 '원래 반응'(08 D-18 7). source: final_set = 사람 최종 세트, manual_csv = labels\\manual-*.csv 손라벨(읽기만).",
      "properties": {
        "source": {"enum": ["final_set", "manual_csv"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "count": {"type": "integer", "minimum": 0},
        "file": {"type": ["string", "null"], "pattern": "^manual-[A-Za-z0-9_.-]{1,60}\\.csv$", "description": "손라벨 파일 이름(폴더 없이). 최종 세트면 null."}
      }
    },
    "startBody": {
      "type": "object",
      "required": ["mode", "project_id", "source", "audio", "range", "reference"],
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "streamer"},
        "project_id": {"$ref": "#/$defs/uuid"},
        "source": {"enum": ["replay"], "description": "채팅 출처(D-05). F 첫 판은 실제 채팅 재생만."},
        "audio": {"enum": ["muted"], "description": "첫 판은 영상 소리를 통째로 끈다(18 6-2)."},
        "range": {"$ref": "#/$defs/range"},
        "reference": {"$ref": "#/$defs/reference"}
      }
    },
    "pickBody": {
      "type": "object",
      "required": ["chat_id", "picked_vod_ms", "wall_at", "source"],
      "additionalProperties": false,
      "properties": {
        "chat_id": {"$ref": "#/$defs/chatId"},
        "picked_vod_ms": {"$ref": "#/$defs/ms", "description": "누른 순간의 재생 위치(VOD 시각)."},
        "wall_at": {"$ref": "#/$defs/datetime"},
        "source": {"enum": ["replay"]}
      }
    },
    "unpickBody": {
      "type": "object",
      "required": ["chat_id", "vod_ms", "wall_at"],
      "additionalProperties": false,
      "properties": {
        "chat_id": {"$ref": "#/$defs/chatId"},
        "vod_ms": {"$ref": "#/$defs/ms", "description": "취소한 순간의 재생 위치."},
        "wall_at": {"$ref": "#/$defs/datetime"}
      }
    },
    "compareBody": {
      "type": "object",
      "required": ["same", "mine_only", "orig_only", "reference_count", "hit_rate", "median_diff_ms", "diff_count", "reference_sha256", "range", "until_ms"],
      "additionalProperties": false,
      "properties": {
        "same": {"type": "integer", "minimum": 0},
        "mine_only": {"type": "integer", "minimum": 0},
        "orig_only": {"type": "integer", "minimum": 0},
        "reference_count": {"type": "integer", "minimum": 0, "description": "범위 안 원래 반응 수(맞힌 비율의 분모)."},
        "hit_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "같음 / 원래 반응 수. 원래 반응이 0 이면 null."},
        "median_diff_ms": {"type": ["integer", "null"], "description": "같음 행의 (고른 시각 − 원래 반응 시각) 중앙값. 음수 = 먼저 골랐다."},
        "diff_count": {"type": "integer", "minimum": 0},
        "reference_sha256": {"$ref": "#/$defs/sha256"},
        "range": {"$ref": "#/$defs/range"},
        "until_ms": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ms"}], "description": "이 시각까지 본 채팅만 셌다(구간 끝 전에 견주기를 눌렀을 때)."}
      }
    },
    "endBody": {
      "type": "object",
      "required": ["reason", "picks"],
      "additionalProperties": false,
      "properties": {
        "reason": {"enum": ["compare", "segment_end", "closed"]},
        "picks": {"type": "integer", "minimum": 0, "description": "끝날 때 고른 채팅 수."}
      }
    }
  }
}
