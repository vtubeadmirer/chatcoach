{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vtubeadmirer/chatcoach/blob/main/schemas/viewer-event.schema.json",
  "title": "시청자 훈련 기록 한 줄 (viewer/<session_id>.jsonl)",
  "description": "시청자 훈련(G) 세션 기록 파일의 한 줄(08 D-01 시청자 훈련, D-20 4, 21 6-3). 라벨 기록(label-event)·스트리머 훈련 기록(training-event)과 다른 폴더·다른 종류다. 파일은 추가만 하는 JSON Lines(UTF-8, BOM 없음, LF), 한 줄 = 기록 1건. 시청자가 쓴 연습 글(write.body.text)은 이 파일에만 두고, 폴더 viewer/ 는 보호 구역(project.protected_zone)이라 내보내기·보호 구역 없는 백업에 들어가지 않는다. 채팅 본문·닉네임·전사문(다른 사람의 글)은 넣지 않는다 — 세 축 단계와 까닭 코드, VOD 시각(ms), 숫자만. 시청자가 쓴 글은 시나리오·LLM 입력에 넣지 않는다(20 6장). app/viewer_store.py 가 이 스키마로 검사한다(store.LabelSchema 해석기).",
  "type": "object",
  "required": ["v", "id", "seq", "kind", "session_id", "labeler_id", "created_at", "app_version", "body"],
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1, "description": "시청자 훈련 기록 형식 버전."},
    "id": {"$ref": "#/$defs/uuid"},
    "seq": {"type": "integer", "minimum": 1, "description": "파일 안 순번. 1부터 1씩 늘어난다."},
    "kind": {"enum": ["viewer.start", "viewer.write", "viewer.end"]},
    "session_id": {"$ref": "#/$defs/viewerSessionId"},
    "labeler_id": {"$ref": "#/$defs/labelerId"},
    "created_at": {"$ref": "#/$defs/datetime", "description": "기록한 벽시계 시각(OS 시간대 오프셋 포함)."},
    "app_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"},
    "body": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "viewer.start"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/startBody"}}}},
    {"if": {"properties": {"kind": {"const": "viewer.write"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/writeBody"}}}},
    {"if": {"properties": {"kind": {"const": "viewer.end"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/endBody"}}}}
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "labelerId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$", "description": "라벨러(사용자) 코드. 표시 이름은 넣지 않는다."},
    "viewerSessionId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}-VW-[0-9]{8}-[a-z0-9]{4}$", "description": "'<labeler_id>-VW-<yyyymmdd>-<4자>'. 라벨 세션 종류 코드(P·RS·R2·AD·OR·AN)·스트리머 훈련(TR)과 겹치지 않는다."},
    "datetime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?([+-][0-9]{2}:[0-9]{2}|Z)$"},
    "ms": {"type": "integer", "minimum": 0},
    "count": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenarioId": {"type": "string", "pattern": "^SC-[0-9]{8}-[0-9a-f]{4}$"},
    "range": {
      "type": "object",
      "required": ["start_ms", "end_ms"],
      "additionalProperties": false,
      "properties": {"start_ms": {"$ref": "#/$defs/ms"}, "end_ms": {"$ref": "#/$defs/ms"}}
    },
    "level": {"enum": ["good", "ok", "weak"], "description": "축 단계 3개: good = 좋음, ok = 보통, weak = 아쉬움(21 6-1). 합계 점수는 두지 않는다(D-20 2)."},
    "reasonCode": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,39}$", "description": "까닭 코드(채점기 app/core/viewer_score 가 정한 짧은 영문 코드, 예: topic.flow_hit · expand.open_question · repeat.fresh). 화면의 까닭 한 줄(글)은 저장하지 않는다 — 채점기에 따라 쓴 글의 낱말이 들어갈 수 있다."},
    "axis": {
      "type": "object",
      "required": ["level", "code"],
      "additionalProperties": false,
      "properties": {"level": {"$ref": "#/$defs/level"}, "code": {"$ref": "#/$defs/reasonCode"}}
    },
    "scores": {
      "type": "object",
      "required": ["topic", "expand", "repeat"],
      "additionalProperties": false,
      "description": "세 축(21 6-2): topic = 주제 적합성, expand = 대화 확장성, repeat = 반복 여부(good = 되풀이 없음).",
      "properties": {"topic": {"$ref": "#/$defs/axis"}, "expand": {"$ref": "#/$defs/axis"}, "repeat": {"$ref": "#/$defs/axis"}}
    },
    "levelCounts": {
      "type": "object",
      "required": ["good", "ok", "weak"],
      "additionalProperties": false,
      "properties": {"good": {"$ref": "#/$defs/count"}, "ok": {"$ref": "#/$defs/count"}, "weak": {"$ref": "#/$defs/count"}}
    },
    "startBody": {
      "type": "object",
      "required": ["mode", "project_id", "source", "audio", "range"],
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "viewer"},
        "project_id": {"$ref": "#/$defs/uuid"},
        "source": {"enum": ["replay"], "description": "흐르는 채팅의 바탕(D-05). 실제 채팅 재생 + (있으면) 가상 채팅."},
        "audio": {"enum": ["on"], "description": "시청자 자리라 소리를 켜고 본다(21 6-1)."},
        "range": {"$ref": "#/$defs/range"},
        "scenario_id": {"$ref": "#/$defs/scenarioId", "description": "(선택) 섞은 가상 채팅 시나리오. 없으면 실제 채팅만."},
        "scenario_sha256": {"$ref": "#/$defs/sha256", "description": "(선택) 그 시나리오 파일의 sha256."},
        "virtual_lines": {"$ref": "#/$defs/count", "description": "(선택) 화면에 섞은 가상 채팅 수."}
      }
    },
    "writeBody": {
      "type": "object",
      "required": ["vod_ms", "text", "chars", "scores"],
      "additionalProperties": false,
      "properties": {
        "vod_ms": {"$ref": "#/$defs/ms", "description": "Enter 를 누른 순간의 재생 위치(VOD 시각). 채팅 패널의 '연습' 줄도 이 시각에 흐른다."},
        "text": {"type": "string", "minLength": 1, "maxLength": 200, "description": "시청자가 쓴 연습 채팅(본인 글). 이 파일(보호 구역)에만 둔다. 로그·상태 줄·보고·내보내기에는 넣지 않는다."},
        "chars": {"type": "integer", "minimum": 1, "maximum": 200, "description": "글자 수(숫자만 보는 곳에서 쓴다)."},
        "scores": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scores"}], "description": "세 축 단계·까닭 코드. 채점기를 쓸 수 없었으면 null(그때는 score_error)."},
        "score_error": {"$ref": "#/$defs/reasonCode", "description": "(선택) 채점 실패 종류(예: scorer_missing, scorer_failed)."},
        "scorer": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,30}/[0-9A-Za-z.+-]{1,20}$", "description": "(선택) 채점기 이름/판(예: viewer_score/0.1)."}
      }
    },
    "endBody": {
      "type": "object",
      "required": ["reason", "writes", "levels"],
      "additionalProperties": false,
      "properties": {
        "reason": {"enum": ["segment_end", "summary", "closed"], "description": "segment_end = 구간 끝에서 요약, summary = [요약] 단추·Ctrl+Enter, closed = 요약 없이 닫음."},
        "writes": {"$ref": "#/$defs/count", "description": "쓴 연습 채팅 수."},
        "levels": {
          "type": "object",
          "required": ["topic", "expand", "repeat"],
          "additionalProperties": false,
          "description": "축마다 단계 분포(채점된 쓰기만).",
          "properties": {"topic": {"$ref": "#/$defs/levelCounts"}, "expand": {"$ref": "#/$defs/levelCounts"}, "repeat": {"$ref": "#/$defs/levelCounts"}}
        },
        "examples": {"$ref": "#/$defs/count", "description": "(선택) 요약에 보인 '다른 시청자라면' 예시 수(가상 retrieved)."}
      }
    }
  }
}
