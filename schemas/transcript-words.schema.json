{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vtubeadmirer/chatcoach/blob/main/schemas/transcript-words.schema.json",
  "title": "시각별 전사 낱말 (transcript-words)",
  "description": "엔진(engine/transcript_words.py)이 asr.json(영상 파일 시각)을 프로젝트의 활성 보정값으로 VOD 시각에 옮겨, 고정 길이 창(기본 10초)마다 정규화한 낱말 집합만 담은 파일(08 D-20 3, 21 6-2). G 시청자 훈련 채점기(app/core/viewer_score)가 '보낸 시각 앞 60~120초 전사 낱말' 겹침을 셀 때 읽는다. 문장 본문은 담지 않는다: 낱말은 창마다 겹치지 않게 글자 순으로 정렬해 말한 순서·되풀이가 남지 않는다. 낱말 규칙은 app/core/textnorm.tokens(그 판이 engine.textnorm 칸에 적힌다). 기본 위치 <project>\\derived\\asr-words.json(보호 구역 derived/asr*). 시범 프로젝트(pilot-*)에서는 평문으로 만들지 않는다(D-15 8, D-20 5). 같은 규칙을 engine/transcript_words.validate 가 손으로 검사한다.",
  "type": "object",
  "required": ["schema", "schema_version", "run_id", "created_at", "engine", "target", "time_axis", "calibration", "window_ms", "range", "windows"],
  "additionalProperties": false,
  "$defs": {
    "word": {"type": "string", "pattern": "^[0-9a-z가-힣]{2,12}$", "description": "2~12자 낱말(한글 음절·영문 소문자·숫자). 기호·공백을 받지 않아 문장을 담을 수 없다."},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema": {"const": "chatcoach/transcript-words"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "created_at": {"type": "string", "minLength": 1, "description": "ISO 8601 (시간대 포함)."},
    "engine": {
      "type": "object",
      "required": ["name", "version", "config_sha256", "textnorm"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "textnorm": {"type": "string", "minLength": 1, "description": "낱말 규칙 판(app/core/textnorm.VERSION). 앱은 자기 판과 다르면 쓰지 않는다."}
      }
    },
    "target": {
      "type": "object",
      "required": ["project_id", "video_no", "asr_sha256"],
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": ["string", "null"]},
        "video_no": {"type": ["string", "null"]},
        "asr_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "time_axis": {"const": "vod_ms", "description": "모든 시각은 VOD 밀리초(채팅 시각과 같은 축)."},
    "calibration": {
      "type": "object",
      "description": "바꿀 때 쓴 보정(03 4-2: 영상 파일 시각 = VOD 시각 + offset_ms). 숫자·코드만.",
      "required": ["source", "rev", "method", "status", "offset_ms", "file_start_in_vod_ms"],
      "additionalProperties": false,
      "properties": {
        "source": {"enum": ["project.json", "project.json+cli_file_start", "cli", "default"]},
        "rev": {"type": ["integer", "null"], "minimum": 0},
        "method": {"enum": ["single_offset", "piecewise_linear"]},
        "status": {"enum": ["verified", "unverified", "skipped"]},
        "offset_ms": {"type": "integer", "description": "project.schema 꼴(클립 시작을 합친 값). piecewise_linear 에서는 참고값."},
        "file_start_in_vod_ms": {"type": "integer"}
      }
    },
    "window_ms": {"type": "integer", "minimum": 1},
    "range": {
      "type": "object",
      "required": ["start_ms", "end_ms"],
      "additionalProperties": false,
      "properties": {"start_ms": {"type": "integer"}, "end_ms": {"type": "integer"}}
    },
    "stats": {"type": "object", "additionalProperties": {"type": "number"}, "description": "숫자만."},
    "windows": {
      "type": "array",
      "description": "낱말이 하나라도 있는 창만, start_ms 순. 창은 VOD 0 에 맞춘 [k×window_ms, (k+1)×window_ms).",
      "items": {
        "type": "object",
        "required": ["start_ms", "end_ms", "words", "segments"],
        "additionalProperties": false,
        "properties": {
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "words": {"type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": {"$ref": "#/$defs/word"}, "description": "글자 순 정렬, 겹침 없음."},
          "segments": {"type": "integer", "minimum": 1, "description": "이 창에 낱말을 낸 발화 구간 수."}
        }
      }
    }
  }
}
